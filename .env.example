# Public PeerJS signaling defaults
VITE_PEER_HOST=0.peerjs.com
VITE_PEER_PORT=443
VITE_PEER_PATH=/
VITE_PEER_SECURE=true
VITE_PEER_KEY=peerjs
# Google and Cloudflare public STUN servers are included automatically.
# Optional TURN for symmetric NAT: Metered/Open Relay or paid Twilio/Cloudflare TURN.
# Comma separated URLs allowed. VITE values are public in the browser bundle;
# use short-lived/restricted credentials from your TURN provider.
VITE_TURN_URL=
VITE_TURN_USER=
VITE_TURN_PASS=
